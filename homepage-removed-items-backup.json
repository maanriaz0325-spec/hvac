    "trustStripItem": "<div class=\"trust-strip-item\">\n          <div class=\"trust-icon-box\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n              <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n              <polyline points=\"12 6 12 12 16 14\"></polyline>\n            </svg>\n          </div>\n          <div class=\"trust-text-wrap\">\n            <span class=\"trust-title\">Same-Day Service</span>\n            <span class=\"trust-sub\">Fast dispatch when you call.</span>\n          </div>\n        </div>",
    "countyCoverageText": "Fast emergency response and same-day scheduling throughout Miami-Dade residential neighborhoods and commercial centers.",
    "reviewsSection": "<section class=\"reviews-section\" id=\"reviews\">\n    <div class=\"container\">\n      <div class=\"section-header\">\n        <span class=\"section-label\">CUSTOMER REVIEWS</span>\n        <h2 class=\"section-title\">What Our Customers Say</h2>\n        <div class=\"reviews-rating-aggregate\" style=\"display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-top: 10px; margin-bottom: 14px; background: rgba(255, 255, 255, 0.08); padding: 8px 18px; border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.15);\">\n          <span class=\"star-rating-exact\" style=\"display: inline-flex; align-items: center; color: #FFB800; font-size: 1.1rem; line-height: 1;\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span style=\"position: relative; display: inline-block; color: #64748B;\"><span style=\"position: absolute; left: 0; top: 0; width: 80%; overflow: hidden; color: #FFB800;\">★</span>★</span>\n          </span>\n          <strong style=\"color: #FFFFFF; font-size: 1.05rem; font-weight: 800;\">4.8 Rating</strong>\n          <span style=\"color: #CBD5E1; font-size: 0.9rem;\">&bull; 250+ Verified Reviews</span>\n        </div>\n        <p class=\"section-subtitle\" style=\"color: #A6BFDC;\">\n          Choosing an HVAC company is easier when you can read feedback from people who have used its services. Read our genuine customer reviews across Miami and Miami-Dade County.\n        </p>\n      </div>\n\n      <div class=\"reviews-slider-wrap\">\n        <div class=\"reviews-header-bar\">\n          <div class=\"reviews-slide-indicator\" id=\"reviewSlideIndicator\">\n            Page 1 of 2 (Showing 1-3 of 6 Reviews)\n          </div>\n          <div class=\"reviews-dots\">\n            <div class=\"review-dot active\" data-slide=\"0\" title=\"Slide 1\"></div>\n            <div class=\"review-dot\" data-slide=\"1\" title=\"Slide 2\"></div>\n          </div>\n          <div class=\"reviews-nav-btns\">\n            <button type=\"button\" class=\"btn-carousel\" id=\"prevReviewBtn\" aria-label=\"Previous Reviews Slide\">\n              &larr;\n            </button>\n            <button type=\"button\" class=\"btn-carousel\" id=\"nextReviewBtn\" aria-label=\"Next Reviews Slide\">\n              &rarr;\n            </button>\n          </div>\n        </div>\n\n        <div class=\"reviews-viewport\">\n          <div class=\"reviews-track\" id=\"reviewsTrack\">\n            <!-- SLIDE 1: REVIEWS 1 - 3 -->\n            <div class=\"reviews-slide\">\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"Our AC stopped cooling during a 94° July weekend in Coral Gables. Miami Air Conditioning Repair responded within 90 minutes, replaced the capacitor, and had cold air blowing immediately. Upfront estimate and very fair pricing.\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">Carlos M.</span>\n                    <span class=\"review-location\">Coral Gables, FL</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"Honest mechanics, not salespeople. They diagnosed a blocked condensate drain line causing water to leak around our air handler in Brickell. Explained everything clearly and didn't push an unnecessary replacement.\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">Elena S.</span>\n                    <span class=\"review-location\">Brickell, Miami</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"We called for 24-hour emergency service when our Kendall home AC stopped turning on. The technician was respectful, professional, and knowledgeable. Great customer service from dispatch to repair completion.\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">David R.</span>\n                    <span class=\"review-location\">Kendall, FL</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <!-- SLIDE 2: REVIEWS 4 - 6 -->\n            <div class=\"reviews-slide\">\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"Installed a new high-efficiency central air conditioner in our Doral home. Properly sized equipment, neat ductwork connection, and our monthly FPL electric bills have noticeably decreased. Highly recommended!\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">Gabriela T.</span>\n                    <span class=\"review-location\">Doral, FL</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"Their air duct cleaning and dehumidifier installation in Coconut Grove transformed our indoor air quality. No more musty odors or dust buildup on vents. Very clean work and courteous team.\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">Marcus H.</span>\n                    <span class=\"review-location\">Coconut Grove, Miami</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n\n              <div class=\"review-card\">\n                <div class=\"review-stars\">&#9733;&#9733;&#9733;&#9733;&#9733;</div>\n                <p class=\"review-quote\">\n                  \"We have a commercial property on Miami Beach and rely on them for quarterly maintenance on our rooftop units. Zero downtime for our retail tenants. Extremely dependable partner.\"\n                </p>\n                <div class=\"review-footer\">\n                  <div>\n                    <span class=\"review-author\">Julian P.</span>\n                    <span class=\"review-location\">Miami Beach Property Mgr</span>\n                  </div>\n                  <span class=\"review-badge\">\n                    <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>\n                    Verified Google Review\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>",
